            "post": {
                "tags": [
                    "Contracts"
                ],
                "summary": "Create Contract Proposal",
                "description": "Tenant submits a new rental contract proposal for a unit.",
                "operationId": "73a91076ec6423051d986a4149fa8d87",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "unit_id",
                                    "start_date",
                                    "end_date",
                                    "total_price"
                                ],
                                "properties": {
                                    "unit_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "start_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-11-01"
                                    },
                                    "end_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2027-11-01"
                                    },
                                    "total_price": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 15000000
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Contract Created"
                    },
                    "403": {
                        "description": "Forbidden - Only Tenant can create contract"
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
