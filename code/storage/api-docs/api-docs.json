                                        "type": "string",
                                        "example": "2026-10"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1500000
                                    },
                                    "proof": {
                                        "description": "File bukti bayar (JPG, PNG, PDF max 2MB)",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Payment Submitted"
