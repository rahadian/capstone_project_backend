        "/api/contracts": {
            "get": {
                "tags": [
                    "Contracts"
                ],
                "summary": "Get Contract List",
                "description": "Get list of contracts. Tenant sees their own contracts, Owner sees contracts for their units.",
                "operationId": "971f1fdec41a8eaf0830d94e9ee15496",
