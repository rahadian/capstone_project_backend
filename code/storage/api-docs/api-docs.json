    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "User Registration",
                "description": "Register a new user (Owner or Tenant). If role is tenant, a tenant profile record is automatically created.",
                "operationId": "8e4e3cb7b46126f4696379d3c7eeb4ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "role"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Budi Santoso",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "budi@example.com",
                                        "maxLength": 255
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "081234567890",
                                        "maxLength": 20
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "P@ssw0rd123!",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "P@ssw0rd123!",
                                        "minLength": 8
                                    },
                                    "role": {
                                        "type": "string",
                                        "example": "tenant",
                                        "enum": [
                                            "owner",
                                            "tenant"
                                        ]
                                    },
                                    "id_card": {
                                        "description": "File KTP (JPG, JPEG, PNG, PDF max 2MB). Only for tenant role.",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registration Successful"
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                }
            }
        },
